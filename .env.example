# LLM API Keys
OPENAI_API_KEY=sk-your-openai-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
GROQ_API_KEY=gsk-your-groq-key

# Database
# Leave DATABASE_URL unset for the lightweight local mode (defaults to
# sqlite:///./mcp_agent.db, no separate database server needed). Only set
# this to a postgresql:// URL if you're running the full docker-compose.yml
# stack with Postgres, and have the psycopg driver installed.
# DATABASE_URL=postgresql://user:password@localhost:5432/mcp_agent
# REDIS_URL is optional; the app degrades gracefully if Redis isn't reachable.
# REDIS_URL=redis://localhost:6379/0

# MCP Server
# The backend's agent spawns the MCP server as a local subprocess and talks
# to it over stdio, so MCP_SERVER_TRANSPORT must stay "stdio" unless you run
# the MCP server as its own standalone HTTP service (full docker-compose.yml
# stack) and update the agent's MCP client to connect over HTTP accordingly.
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8000
MCP_SERVER_TRANSPORT=stdio

# Agent
AGENT_DEFAULT_LLM=openai
AGENT_MAX_STEPS=20
AGENT_MAX_CONTEXT_TOKENS=8000

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8001
BACKEND_DEBUG=true

# Frontend
REACT_APP_API_URL=http://localhost:8001

# Gmail OAuth (required to let the agent connect to a user's Gmail account)
# Create an OAuth 2.0 Web application client in Google Cloud Console, enable
# the Gmail API, and add GOOGLE_REDIRECT_URI as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth/callback

# Used to encrypt stored OAuth tokens at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
